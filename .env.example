# WP Doctor AI — example environment variables.
# Copy to .env.local and replace each placeholder with a real value.
# NEVER commit a real .env.local file. All values below are placeholders.

# PostgreSQL (Prisma). Dev/test databases are separate; see README.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wpdoctor_dev"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wpdoctor_test"

# Better Auth. BETTER_AUTH_SECRET must be a long random string (32+ bytes).
# BETTER_AUTH_URL is the public base URL of this app.
BETTER_AUTH_SECRET="change-me-to-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# AI provider (server-side only; Milestone 4). NOT CONFIGURED by default:
# set AI_PROVIDER="openai" plus a real OPENAI_API_KEY and OPENAI_MODEL to
# enable explanations. Without them the API honestly returns AI_NOT_CONFIGURED.
AI_PROVIDER="your-ai-provider-name"
OPENAI_API_KEY="your-ai-api-key-here"
OPENAI_MODEL=""
AI_TIMEOUT_MS="30000"
AI_MAX_OUTPUT_TOKENS="2000"

# Email / SMTP — NOT CONFIGURED. Password reset and email verification do
# not work until these are set AND tested (later milestone). Do not set them
# to a real provider until that milestone.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Website Speed Analyzer (server-side only; Milestone 9). NOT CONFIGURED
# by default: without these keys the providers report NOT_CONFIGURED and
# reports still show the sources that did succeed (HTTP preflight always
# runs). Never expose these keys to the frontend or commit real values.
# Get keys in Google Cloud Console: enable the PageSpeed Insights API for
# GOOGLE_PAGESPEED_API_KEY and the Chrome UX Report API for
# GOOGLE_CRUX_API_KEY, then restrict each key to its API. Quotas are
# Google-side; access is not unlimited or guaranteed free.
GOOGLE_PAGESPEED_API_KEY=<redacted>
GOOGLE_CRUX_API_KEY=<redacted>

# Backup storage + encryption (server-side only; Milestone 14).
# NOT CONFIGURED by default: until all three are set, backup execution is
# BLOCKED by the gates (never silently plaintext, never silently local).
# BACKUP_ENCRYPTION_KEY must be exactly 64 hex chars (32 bytes) or base64
# of 32 bytes — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_STORAGE_DIR must be a private, non-web-accessible directory.
# BACKUP_STORAGE_DRIVER="local" is development/test ONLY: in production
# local storage is BLOCKED and a private persistent object store is
# required (no object-storage adapter exists yet — see
# docs/deployment-checklist.md). Never use a NEXT_PUBLIC_* variable here.
BACKUP_STORAGE_DRIVER
BACKUP_STORAGE_DIR
BACKUP_ENCRYPTION_KEY

# Uptime Monitor scheduler (server-side only; Milestone 16). The tick
# endpoint POST /api/monitoring/internal/tick accepts ONLY this secret
# (header x-monitoring-tick-secret, constant-time comparison). If unset,
# the tick route honestly returns 503 SCHEDULER_NOT_CONFIGURED and no
# recurring checks run. Never expose this value to the browser, logs, or
# API responses. An external cron must call the tick endpoint regularly
# (e.g. every 5 minutes) for scheduled monitoring to be operational.
MONITORING_TICK_SECRET=""
