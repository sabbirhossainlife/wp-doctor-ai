  confidence       String
  evidenceStatus   String?
  limitations      String?
  relativePath     String?
  componentId      String?
  installedVersion String?
  referenceVersion String?
  ruleId           String?
  checksumId       String?
  evidenceCategory String?
  createdAt        DateTime           @default(now())

