model MalwareAiAnalysis {
  id            String            @id @default(cuid())
  diagnosticId  String            @unique
  diagnostic    MalwareDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  status        String
  provider      String
  model         String?
