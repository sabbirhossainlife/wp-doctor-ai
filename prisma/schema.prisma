// Tool 11 (Milestone 15): SEO Spam & Indexing Checker. Mirrors Tools
// 02-10 diagnostic shapes. A SeoDiagnostic is a user-owned, immutable
// report of ONE synchronous run: pinned passive homepage/robots/sitemap
// checks + snapshot SEO-plugin evidence (websiteId path only). Historical
// reports are never updated on re-scan (a new row per run). Never stored:
// HTML bodies, matched snippets, secrets, credentials, absolute paths,
// query strings, fragments, or internal IPs. Stale-snapshot runs are
// BLOCKED at the service layer (422) and persist NO row. Search Console
// is NOT_CONFIGURED: no Search Console data is ever consulted or stored,
// so no finding ever claims indexed/deindexed status.
model SeoDiagnostic {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  websiteId             String?
  website               Website?             @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  sanitizedWebsiteUrl   String
  requestedTarget       String
  finalUrl              String?
  executionStatus       String
  snapshotSchemaVersion Int?
  snapshotReceivedAt    DateTime?
  snapshotFreshness     String
  homepageSummary       Json                 @default("{}")
  robotsSummary         Json                 @default("{}")
  sitemapSummary        Json                 @default("{}")
  spamSignals           Json                 @default("{}")
  seoPluginSummary      Json                 @default("{}")
  advisoryContext       Json                 @default("{}")
  searchConsoleStatus   String               @default("NOT_CONFIGURED")
  summary               Json
  limitations           Json                 @default("[]")
  startedAt             DateTime             @default(now())
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  findings              SeoDiagnosticFinding[]
  aiAnalysis            SeoAiAnalysis?

  @@index([userId, createdAt])
  @@index([websiteId])
  @@map("seo_diagnostic")
}

model SeoDiagnosticFinding {
  id             String        @id @default(cuid())
  diagnosticId   String
  diagnostic     SeoDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  code           String
  severity       String
  title          String
  explanation    String
  evidence       Json
  recommendation String
  confidence     String
  evidenceStatus String?
  limitations    String?
  checkId        String?
  evidenceCategory String?
  createdAt      DateTime      @default(now())

  @@index([diagnosticId])
  @@map("seo_diagnostic_finding")
}

model SeoAiAnalysis {
  id            String        @id @default(cuid())
  diagnosticId  String        @unique
  diagnostic    SeoDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  status        String
  provider      String
  model         String?
  schemaVersion String
  analysis      Json?
  errorCode     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?

  @@map("seo_ai_analysis")
}

// Tool 10 (Milestone 14): Backup, Restore & Migration Assistant.
// Archive CONTENTS are never stored here: BackupArtifact holds only the
// bounded manifest, counts, sizes, hashes, and encryption key identifier.
// The encrypted archive bytes live in private storage (local adapter in
// dev/test; no production adapter configured). The SaaS PostgreSQL
// database is NEVER a WordPress restore target: restore/migration
// targets are Website rows (a registered WordPress site), and no code
// path in lib/backup/ opens the SaaS database as a WP target.
model BackupArtifact {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceWebsiteId    String?
  sourceWebsite      Website? @relation("BackupArtifactSource", fields: [sourceWebsiteId], references: [id], onDelete: SetNull)
  mode               String
  status             String   @default("UNVERIFIED") // UNVERIFIED | VERIFIED | FAILED | TAMPERED | DELETED
  manifest           Json
  storageId          String
  storageDriver      String   @default("local")
  encryptionScheme   String   @default("AES-256-GCM")
  encryptionKeyId    String?
  archiveBytes       Int?
  archiveSha256      String?
  tableCount         Int      @default(0)
  fileCount          Int      @default(0)
  verificationStatus String   @default("UNVERIFIED")
  verifiedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  operations         BackupOperation[]
  downloadTokens     BackupDownloadToken[]

  @@index([userId, createdAt])
  @@map("backup_artifact")
}

model BackupOperation {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  String // BACKUP | RESTORE | MIGRATION
  state                 String   @default("DRAFT")
  mode                  String?
  sourceWebsiteId       String?
  sourceWebsite         Website? @relation("BackupOperationSource", fields: [sourceWebsiteId], references: [id], onDelete: SetNull)
  destinationWebsiteId  String?
  destinationWebsite    Website? @relation("BackupOperationDestination", fields: [destinationWebsiteId], references: [id], onDelete: SetNull)
  backupArtifactId      String?
  backupArtifact        BackupArtifact? @relation(fields: [backupArtifactId], references: [id], onDelete: SetNull)
  rollbackBackupId      String?
  plan                  Json     @default("{}")
  planHash              String?
  confirmationTokenHash String?
  confirmationExpiresAt DateTime?
  confirmationUsedAt    DateTime?
  preflight             Json     @default("{}")
  errorCode             String?
  verification          Json     @default("{}")
  fileCount             Int?
  tableCount            Int?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  events                BackupOperationEvent[]

  @@index([userId, createdAt])
  @@index([destinationWebsiteId, state])
  @@map("backup_operation")
}

model BackupOperationEvent {
  id          String          @id @default(cuid())
  operationId String
  operation   BackupOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  state       String
  note        String
  createdAt   DateTime        @default(now())

  @@index([operationId, createdAt])
  @@map("backup_operation_event")
}

model BackupDownloadToken {
  id         String         @id @default(cuid())
  artifactId String
  artifact   BackupArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime       @default(now())

  @@index([artifactId])
  @@map("backup_download_token")
}

// Tool 12 (Milestone 16): Uptime & Maintenance Monitor.
// Monitors bind ONLY to owned registered Website rows; no arbitrary URL
// is ever stored as a target. Target identity is a redacted fingerprint
// (protocol + host + port + path, no query, no credentials). Never
// stored: response bodies, HTML snippets, cookies, auth headers,
// internal IPs, full query strings, or provider secrets.
model WebsiteMonitor {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  websiteId                String
  website                  Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  targetHost               String
  targetUrl                String
  targetFingerprint        String
  targetConfirmed          Boolean  @default(true)
  targetConfirmedAt        DateTime @default(now())
  status                   String   @default("ENABLED") // ENABLED | PAUSED
  checkIntervalMinutes     Int      @default(15)
  warningLatencyMs         Int      @default(1000)
  highLatencyMs            Int      @default(3000)
  failureThreshold         Int      @default(2)
  recoveryThreshold        Int      @default(2)
  maintenanceDetectionEnabled Boolean @default(true)
  notifyInApp              Boolean  @default(true)
  notifyEmail              Boolean  @default(false)
  currentState             String   @default("UNKNOWN") // HEALTHY | SUSPECTED_FAILURE | DOWN | RECOVERING | MAINTENANCE | UNKNOWN | PAUSED | BLOCKED
  consecutiveFailures      Int      @default(0)
  consecutiveSuccesses     Int      @default(0)
  firstFailureAt           DateTime?
  lastCheckAt              DateTime?
  lastSuccessAt            DateTime?
  nextCheckAt              DateTime @default(now())
  leaseOwner               String?
  leaseExpiresAt           DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  checks                   MonitorCheck[]
  incidents                MonitorIncident[]
  windows                  MaintenanceWindow[]
  notifications            MonitorNotification[]

  @@index([userId, createdAt])
  @@index([status, nextCheckAt])
  @@map("website_monitor")
}

model MonitorCheck {
  id                String   @id @default(cuid())
  monitorId         String
  monitor           WebsiteMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  scheduledAt       DateTime?
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  outcome           String   // UP | DEGRADED | FAILURE | MAINTENANCE_OBSERVED | BLOCKED | UNKNOWN | STALE
  failureReason     String?  // DNS | TLS | CONNECTION | TIMEOUT | HTTP_5XX | null
  httpStatus        Int?
  latencyMs         Int?
  latencyWarning    Boolean  @default(false)
  finalUrl          String?
  redirectCount     Int      @default(0)
  crossHostRedirectBlocked Boolean @default(false)
  maintenanceIndicator String @default("NOT_OBSERVED") // OBSERVED | NOT_OBSERVED | INSUFFICIENT_EVIDENCE
  monitoringGap     Boolean  @default(false)
  triggeredBy       String   @default("SCHEDULED") // SCHEDULED | MANUAL
  workerId          String?
  errorCode         String?
  createdAt         DateTime @default(now())

  @@index([monitorId, createdAt])
  @@map("monitor_check")
}

model MonitorIncident {
  id               String   @id @default(cuid())
  monitorId        String
  monitor          WebsiteMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  type             String   @default("DOWN")
  severity         String   @default("HIGH")
  status           String   @default("OPEN") // OPEN | RECOVERED
  firstFailureAt   DateTime
  confirmedAt      DateTime
  recoveredAt      DateTime?
  lastFailureAt    DateTime
  failureCount     Int      @default(0)
  successCount     Int      @default(0)
  failureReason    String?
  escalationSent   Boolean  @default(false)
  acknowledgedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  notifications    MonitorNotification[]

  @@index([monitorId, status, createdAt])
  @@map("monitor_incident")
}

model MaintenanceWindow {
  id            String   @id @default(cuid())
  monitorId     String
  monitor       WebsiteMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  timezone      String
  suppressAlerts Boolean @default(true)
  pauseChecks   Boolean  @default(false)
  status        String   @default("ACTIVE") // ACTIVE | CANCELLED | COMPLETED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([monitorId, startAt])
  @@index([userId, startAt])
  @@map("maintenance_window")
}

model MonitorNotification {
  id            String   @id @default(cuid())
  monitorId     String
  monitor       WebsiteMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  incidentId    String?
  incident      MonitorIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  windowId      String?
  type          String
  channel       String   @default("IN_APP")
  status        String   @default("CREATED") // CREATED | SUPPRESSED | READ | DISMISSED
  dedupKey      String   @unique
  title         String
  body          String
  emailStatus   String?
  acknowledgedAt DateTime?
  createdAt     DateTime @default(now())

  @@index([monitorId, createdAt])
  @@map("monitor_notification")
}

model MonitoringSchedulerState {
  id            String   @id @default("scheduler")
  lastTickAt    DateTime?
  lastTickSummary Json @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("monitoring_scheduler_state")
}
